# Eventura CMS — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# DO NOT commit real values. Set these as Cloudflare Pages Secrets.
# Dashboard → Workers & Pages → eventura → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Admin login password (choose something strong, >16 chars recommended)
ADMIN_PASSWORD=your-strong-admin-password-here

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
