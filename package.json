{
  "name": "eventura-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "lint": "cd frontend && npm run lint",
    "deploy": "npm run build && cd backend && npm run deploy",
    "backend:dev": "node ./backend/node_modules/wrangler/bin/wrangler.js pages dev ./frontend/out --port 8788"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
