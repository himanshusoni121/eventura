{
  "name": "eventura-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for Eventura CMS",
  "scripts": {
    "dev": "wrangler pages dev ../frontend/out --compatibility-date=2024-01-01 --binding EVENTURA_R2=eventura-cms",
    "deploy": "wrangler pages deploy ../frontend/out --project-name eventura"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
